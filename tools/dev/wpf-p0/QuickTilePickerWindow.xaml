<Window xmlns:loc="clr-namespace:L_Mechrevo.WpfP0.Resources" x:Class="L_Mechrevo.WpfP0.QuickTilePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{x:Static loc:WpfStrings.QuickTilePickerWindow_Title}"
        Width="340" Height="500"
        MinWidth="300" MinHeight="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontWeight="Normal"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        Icon="Assets/Icons/app.png">

    <Window.Resources>
        <Style x:Key="PickerButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PickerCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="7" Padding="8,6">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        Background="Transparent" VerticalAlignment="Center">
                                    <TextBlock x:Name="Mark" Text="✓" FontSize="10" Visibility="Collapsed"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{x:Static loc:WpfStrings.QuickTilePickerWindow_Text}" FontSize="12" />
            <TextBlock x:Name="HintText" Text="{x:Static loc:WpfStrings.HintText_Text_3}" Style="{DynamicResource MutedText}" FontSize="10" Margin="0,3,0,8" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ChoicesList" AllowDrop="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Style="{StaticResource PickerCheck}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  Click="Choice_Click">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="24" Height="18" VerticalAlignment="Center">
                                    <TextBlock x:Name="GlyphIcon" Text="{Binding Glyph}" FontFamily="{Binding GlyphFont}" FontSize="{Binding GlyphSize}" FontWeight="{Binding GlyphWeight}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Viewbox x:Name="FanBoostIcon" Width="16" Height="16" Visibility="Collapsed"
                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="16" Height="16">
                                            <Path Fill="{DynamicResource TextBrush}"
                                                  Data="M8,8 C6,5 6,2 8,1 C10,2 10,5 8,8 Z M8,8 C11,6 14,7 15,9 C13,11 10,10 8,8 Z M8,8 C10,11 10,14 8,15 C6,14 6,11 8,8 Z M8,8 C5,10 2,9 1,7 C3,5 6,6 8,8 Z M8,7 A1,1 0 1 1 8,9 A1,1 0 1 1 8,7 Z" />
                                        </Canvas>
                                    </Viewbox>
              <Viewbox x:Name="TouchpadIcon" Width="16" Height="16" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="16" Height="16">
                  <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.3" Fill="Transparent" Data="M2,3 L14,3 L14,13 L2,13 Z" />
                  <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.3" Data="M5,10 L11,10" />
                </Canvas>
              </Viewbox>
              <Rectangle x:Name="CopilotIcon" Width="18" Height="17" Visibility="Collapsed"
                         Fill="{DynamicResource TextBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                <Rectangle.OpacityMask>
                  <ImageBrush Stretch="Uniform" ImageSource="/L-Mechrevo;component/Assets/Icons/copilot-line.png" />
                </Rectangle.OpacityMask>
              </Rectangle>
                                </Grid>
                                <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </CheckBox>
                        <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsCopilot}" Value="True">
          <Setter TargetName="GlyphIcon" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="CopilotIcon" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsTouchpad}" Value="True">
          <Setter TargetName="GlyphIcon" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="TouchpadIcon" Property="Visibility" Value="Visible" />
        </DataTrigger>
                            <DataTrigger Binding="{Binding IsFanBoost}" Value="True">
                                <Setter TargetName="GlyphIcon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="FanBoostIcon" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{x:Static loc:WpfStrings.ColorPickerWindow_Content}" Style="{StaticResource PickerButton}" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="{x:Static loc:WpfStrings.QuickTilePickerWindow_Content}" Style="{StaticResource PickerButton}" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
