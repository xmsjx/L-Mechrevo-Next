<Window xmlns:loc="clr-namespace:L_Mechrevo.WpfP0.Resources" x:Class="L_Mechrevo.WpfP0.HidKeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{x:Static loc:WpfStrings.HidKeyboardWindow_Text_9}"
        Width="500" Height="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        Icon="Assets/Icons/app.png">
    <Window.Resources>
        <Style x:Key="HeaderSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Track" Width="24" Height="14" CornerRadius="7"
                                    Background="{DynamicResource TrackBrush}" VerticalAlignment="Center">
                                <Grid VerticalAlignment="Center">
                                    <Ellipse x:Name="Knob" Width="12" Height="12" Fill="White"
                                             VerticalAlignment="Center" HorizontalAlignment="Left" Margin="1,0,0,0" />
                                </Grid>
                            </Border>
                            <ContentPresenter Margin="5,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,1,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{x:Static loc:WpfStrings.HidKeyboardWindow_Text_9}" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="{x:Static loc:WpfStrings.HidKeyboardWindow_Text_8}" Style="{DynamicResource MutedText}" Margin="0,4,0,10" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static loc:WpfStrings.HidKeyboardWindow_Text_7}" VerticalAlignment="Center" />
            <ComboBox x:Name="EffectCombo" Grid.Column="1" Style="{StaticResource RoundCombo}" SelectionChanged="Effect_Changed" />
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static loc:WpfStrings.HidKeyboardWindow_Text_6}" VerticalAlignment="Center" />
            <CheckBox x:Name="PowerCheck" Grid.Column="1" Style="{StaticResource HeaderSwitch}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Grid.Column="2" Text="{x:Static loc:WpfStrings.HidKeyboardWindow_Text_5}" Style="{DynamicResource MutedText}" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static loc:WpfStrings.HidKeyboardWindow_Text_4}" VerticalAlignment="Center" />
            <Slider x:Name="BrightnessSlider" Grid.Column="1" Style="{StaticResource RoundSlider}" Minimum="0" Maximum="100" Value="100" />
            <TextBlock x:Name="BrightnessText" Grid.Column="2" Text="100%" TextAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Grid.Row="4">
            <Grid x:Name="ColorRow" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static loc:WpfStrings.MultiColorLabel_Text}" VerticalAlignment="Center" />
                <Button x:Name="ColorButton" Grid.Column="1" Content="{x:Static loc:WpfStrings.ColorPickerWindow_Title}" Style="{StaticResource FlatButton}" Click="Color_Click" />
            </Grid>
            <Grid x:Name="SpeedRow" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static loc:WpfStrings.HidKeyboardWindow_Text_3}" VerticalAlignment="Center" />
                <Slider x:Name="SpeedSlider" Grid.Column="1" Style="{StaticResource RoundSlider}" Minimum="1" Maximum="10" Value="5" ValueChanged="Speed_Changed" />
                <TextBlock x:Name="SpeedText" Grid.Column="2" Text="5" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="AngleRow" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static loc:WpfStrings.HidKeyboardWindow_Text_2}" VerticalAlignment="Center" />
                <Slider x:Name="AngleSlider" Grid.Column="1" Style="{StaticResource RoundSlider}" Minimum="0" Maximum="360" Value="30" ValueChanged="Angle_Changed" />
                <TextBlock x:Name="AngleText" Grid.Column="2" Text="30°" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="DirectionRow" Margin="0,0,0,8" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="方向" VerticalAlignment="Center" />
                <ComboBox x:Name="DirectionCombo" Grid.Column="1" Style="{StaticResource RoundCombo}" SelectionChanged="Direction_Changed">
                    <ComboBoxItem Content="从左到右" Tag="0" />
                    <ComboBoxItem Content="从右到左" Tag="180" />
                    <ComboBoxItem Content="从上到下" Tag="90" />
                    <ComboBoxItem Content="从下到上" Tag="270" />
                </ComboBox>
            </Grid>
            <Grid x:Name="InputSourceRow" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="输入来源" VerticalAlignment="Center" />
                <ComboBox x:Name="InputSourceCombo" Grid.Column="1" Style="{StaticResource RoundCombo}" SelectionChanged="InputSource_Changed">
                    <ComboBoxItem Content="全局输入（含外接键盘）" Tag="1" />
                    <ComboBoxItem Content="仅内置键盘" Tag="0" />
                </ComboBox>
            </Grid>
            <Grid x:Name="FpsRow" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static loc:WpfStrings.HidKeyboardWindow_Text}" VerticalAlignment="Center" />
                <ComboBox x:Name="FpsCombo" Grid.Column="1" Width="110" Style="{StaticResource RoundCombo}" HorizontalAlignment="Left">
                    <ComboBoxItem Content="15 FPS" Tag="15" />
                    <ComboBoxItem Content="30 FPS" Tag="30" />
                    <ComboBoxItem Content="45 FPS" Tag="45" />
                    <ComboBoxItem Content="60 FPS" Tag="60" />
                </ComboBox>
            </Grid>
            <Grid x:Name="Extra1Row" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="Extra1Label" Text="{x:Static loc:WpfStrings.Extra3Label_Text}" VerticalAlignment="Center" />
                <Slider x:Name="Extra1Slider" Grid.Column="1" Style="{StaticResource RoundSlider}" Minimum="0" Maximum="100" Value="0" ValueChanged="Extra1_Changed" />
                <TextBlock x:Name="Extra1Text" Grid.Column="2" Text="0" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="Extra2Row" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="Extra2Label" Text="{x:Static loc:WpfStrings.Extra3Label_Text}" VerticalAlignment="Center" />
                <Slider x:Name="Extra2Slider" Grid.Column="1" Style="{StaticResource RoundSlider}" Minimum="0" Maximum="100" Value="0" ValueChanged="Extra2_Changed" />
                <TextBlock x:Name="Extra2Text" Grid.Column="2" Text="0" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="ColorCountRow" Margin="0,0,0,8" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="ColorCountLabel" Text="{x:Static loc:WpfStrings.ColorCountLabel_Text}" VerticalAlignment="Center" />
                <Slider x:Name="ColorCountSlider" Grid.Column="1" Style="{StaticResource RoundSlider}" Minimum="1" Maximum="5" Value="1" ValueChanged="ColorCount_Changed" />
                <TextBlock x:Name="ColorCountText" Grid.Column="2" Text="1" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <StackPanel x:Name="MultiColorPanel" Margin="0,0,0,8" Visibility="Collapsed">
                <TextBlock x:Name="MultiColorLabel" Text="{x:Static loc:WpfStrings.MultiColorLabel_Text}" Style="{DynamicResource MutedText}" Margin="0,0,0,4" />
                <UniformGrid x:Name="MultiColorGrid" Columns="5" />
            </StackPanel>
            <Grid x:Name="Extra3Row" Margin="0,0,0,8" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="Extra3Label" Text="{x:Static loc:WpfStrings.Extra3Label_Text}" VerticalAlignment="Center" />
                <Slider x:Name="Extra3Slider" Grid.Column="1" Style="{StaticResource RoundSlider}" Minimum="0" Maximum="100" Value="0" ValueChanged="Extra3_Changed" />
                <TextBlock x:Name="Extra3Text" Grid.Column="2" Text="0" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <CheckBox x:Name="ExtraCheck" Content="{x:Static loc:WpfStrings.ExtraCheck_Content}" Style="{StaticResource HeaderSwitch}" Margin="0,0,0,8" />
            <TextBlock x:Name="StatusText" Style="{DynamicResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Top" />
        </StackPanel>
        <Grid Grid.Row="5" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static loc:WpfStrings.ApplyButton_Content}" Style="{StaticResource FlatButton}" Click="Apply_Click" Margin="0,0,8,0" />
                <Button Content="{x:Static loc:WpfStrings.CpuTuningWindow_Content}" Style="{StaticResource FlatButton}" Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
